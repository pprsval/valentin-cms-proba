---
import home from '../../homepage.json';
const portrait = home.portrait?.replace(/^(?:\.\.\/)*\/?uploads\//, './uploads/');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const modules = import.meta.glob('./{projects,blog}/*.md', { eager: true });
const entries = Object.entries(modules).map(([path, page]) => {
  const href = path.replace(/\.md$/, '/');
  const data = page.frontmatter;
  const base = 'https://portfolio.invalid/';
  const cover = data.cover && new URL(data.cover, new URL(href, base));
  return {
    ...data, href,
    cover: cover?.origin === 'https://portfolio.invalid' ? '.' + cover.pathname : cover?.href,
  };
});
const defaults = [{type:'project', slug:'urban-k1'}, {type:'project', slug:'sample-plate'}];
const featured = (home.featured ?? defaults).slice(0, 3).flatMap(selection => {
  const folder = {project: 'projects', article: 'blog'}[selection.type];
  const entry = entries.find(item => item.href === `./${folder}/${selection.slug}/`);
  return entry ? [entry] : [];
});
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="robots" content="noindex"/><title>Portfolio — Valentin Peres</title>
</head>
<body>
  <header>
    <nav aria-label="Main navigation">{['Home', 'Portfolio', 'Blog', 'About'].map(label => <a aria-current={label === 'Home' ? 'page' : undefined} href={label === 'Home' ? base+'/' : base+'/'+label.toLowerCase()+'/'}>{label}</a>)}</nav>
    <a class="wordmark" href="./" aria-label="Valentin Peres, portfolio">Valentin Peres</a>
  </header>
  <main>
    <section id="about" aria-labelledby="headline">
      <div class="hero">
        <div class="bio"><h1 id="headline">{home.title}</h1><p>{home.description}</p><a class="cta" href="#works">Explore selected work</a></div>
        {portrait && <img class="portrait" src={portrait} alt="Valentin Peres" width="307" height="364" fetchpriority="high"/>}
      </div>
    </section>
    <section class="intro" id="works" aria-labelledby="works-heading"><h2 id="works-heading">Selected Work &amp; Writing</h2></section>
    <div class="gallery">
      {featured.map((project, index) =>
        <a class="project" href={project.href}>
          <figure>{project.cover ? <img src={project.cover} alt="" loading={index < 2 ? 'eager' : 'lazy'}/> : <div class="text-cover">{project.description || project.title}</div>}
            <figcaption><h2>{project.title}</h2><span>{project.href.startsWith('./blog/') ? 'Article' : 'Project'}</span></figcaption>
          </figure>
        </a>
      )}
    </div>
  </main>
  <footer id="contact"><div><strong>Valentin Peres</strong><a class="email" href="mailto:valentin.cad@proton.me">valentin.cad@proton.me</a></div><a href="./admin/" lang="hu">Szerkesztő</a></footer>
</body>
</html>
<style>
  :global(*){box-sizing:border-box}
  :global(body){margin:0;color:#292d2b;background:#fff;font-family:"Century Gothic",Avenir,"Segoe UI",sans-serif}
  a{color:inherit;text-decoration:none}
  a:hover,a:focus-visible{text-decoration:underline;text-underline-offset:.3em}
  header{height:52px;border-bottom:1px solid #333;display:flex;align-items:center;position:relative;padding:0 1.8vw}
  nav{display:flex;gap:2.2rem;font-size:.8rem}
  [aria-current]{text-decoration:underline;text-underline-offset:5px}
  .wordmark,footer strong{font-family:Impact,"Arial Narrow","Franklin Gothic Medium",sans-serif;text-transform:uppercase;font-weight:900;letter-spacing:-.045em}
  .wordmark{position:absolute;left:50%;transform:translateX(-50%) scaleX(.84);font-size:1.4rem;white-space:nowrap}
  .intro{padding:3rem 1.8vw 1.4rem}
  h1{font-size:.82rem;font-style:italic;margin:0 0 1.85rem;font-weight:600}
  .gallery{margin-bottom:4rem;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4rem 1.8vw;padding:0 1.8vw}
  figure{margin:0}figure img{width:100%;aspect-ratio:3/2;object-fit:contain;display:block;background:#f4f2ee}
  figcaption{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;padding:1rem 0;border-bottom:1px solid #c5c5bf}
  h2{font-size:1.35rem;font-weight:550;margin:0}figcaption span,footer{font-size:.83rem}
  .more,#blog{margin:3rem 1.8vw}.more a,#blog a{display:block;width:fit-content;text-decoration:underline;text-underline-offset:4px;margin:1rem 0}
  footer{padding:1.6rem 1.8vw;border-top:1px solid;display:flex;align-items:center;justify-content:space-between}footer strong{font-size:1.2rem}
  @media(max-width:640px){header{padding:0 1.1rem;justify-content:space-between}nav{gap:1rem}.wordmark{position:static;transform:scaleX(.84);transform-origin:right}.intro{padding:2.5rem 1rem 1rem}.gallery{grid-template-columns:1fr;gap:2.3rem;padding:0 1rem}.more,#blog{margin:2.8rem 1rem}footer{padding:1.4rem 1rem}}
  main{max-width:none;margin:0;padding:0} .project{background:transparent} .gallery figure{margin:0} .wordmark{line-height:1} body{margin:0;background:white;font-family:"Century Gothic",Avenir,"Segoe UI",sans-serif}
  header,#about,footer{background:#d3cfc5}
  #about{padding:clamp(3.2rem,6vw,7rem) max(6vw,1.3rem) clamp(4rem,8vw,9rem)}
  .hero{max-width:65rem;margin:auto;display:grid;grid-template-columns:minmax(0,1.45fr) minmax(0,1fr);gap:clamp(3rem,8vw,9rem);align-items:start}
  .hero h1{font-family:Impact,Haettenschweiler,"Arial Narrow",sans-serif;text-transform:uppercase;font-size:clamp(2rem,3vw,3rem);letter-spacing:-.035em;line-height:.99;font-style:normal;font-weight:900;margin:0;max-width:15ch;text-wrap:balance}
  .bio p{margin:1.7rem 0 2.4rem;line-height:1.55;max-width:53ch}
  .cta{display:block;text-align:center;border-radius:4rem;padding:1.15rem;background:#d49a82;color:#292725;font-weight:650}
  .cta:hover{background:#dca991}.portrait{display:block;width:100%;height:auto;aspect-ratio:307/364;object-fit:cover}
  .intro h2{font-style:italic;font-size:.9rem;margin:0}
  footer .email{display:block;margin-top:.5rem;font-size:1rem}
  @media(max-width:640px){.hero{grid-template-columns:1fr;gap:2rem}.portrait{max-width:22rem}.bio p{margin:1.3rem 0 1.6rem}.wordmark{font-size:1.05rem}header nav{gap:.8rem}}
  .text-cover{aspect-ratio:3/2;padding:8%;display:grid;align-content:center;background:#e2dfd6;font-size:clamp(1.15rem,2vw,2rem);line-height:1.3}
nav a[aria-current]{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:.3em}
@media(max-width:440px){header{display:flex;height:auto;flex-direction:column-reverse;align-items:center;gap:.45rem;padding:.65rem 1rem}header nav{gap:1.25rem}}
.hero h1{-webkit-text-stroke:.4px #d3cfc5}
</style>
