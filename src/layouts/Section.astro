---
import Header from './Header.astro';
const {title} = Astro.props;
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex"/><title>{title} — Valentin Peres</title></head><body>
<Header />
<main><h1>{title}</h1><slot/></main><footer><a href="mailto:valentin.cad@proton.me">valentin.cad@proton.me</a></footer></body></html>
<style>
:global(*){box-sizing:border-box}body{margin:0;background:#f9f8f5;color:#292d2b;font:1rem/1.55 "Century Gothic",Avenir,"Segoe UI",sans-serif;min-height:100vh;display:flex;flex-direction:column}a{color:inherit}h1{font-family:Impact,"Arial Narrow",sans-serif;text-transform:uppercase;letter-spacing:-.035em}main{flex:1;width:min(100% - 3rem,76rem);margin:3.5rem auto 5rem;padding:0;max-width:none}h1{font-size:clamp(1.375rem,2vw,1.75rem);line-height:1;margin:0 0 2.5rem}footer{border-top:1px solid;background:#d3cfc5;padding:1.5rem 2vw}
h1{font-family:"Arial Narrow","Aptos Narrow","Segoe UI",Arial,sans-serif;font-weight:400}
</style>
