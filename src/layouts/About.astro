---
import Section from './Section.astro';
const { title, cv } = Astro.props.frontmatter;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pdf = cv?.replace(/^(?:\.\.\/)*\/?uploads\//, base+'/uploads/');
---
<Section title={title}><article><slot/></article>{pdf && <p><a href={pdf} download>Download CV (PDF)</a></p>}</Section>
<style>article{max-width:65ch;font-size:1rem;line-height:1.65}a{display:inline-block;margin-top:1.5rem;background:#d49a82;border-radius:2rem;padding:.7rem 1.5rem;color:inherit}</style>
